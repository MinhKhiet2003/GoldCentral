@{ Layout = null; }
<!doctype html>
<html lang="vi">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#087542">
<title>Âm nhạc Gold · Gold Central</title><link rel="stylesheet" href="/portal/portal.css?v=57">
</head>
<body class="music-page" data-event-theme="october20">
<script>try{const t=JSON.parse(localStorage.getItem('gold-portal-event-theme')||'null'),k=t?.enabled&&['october20','halloween','christmas','new-year'].includes(t.eventKey)?t.eventKey:'none';if(t){document.body.dataset.eventTheme=k;for(const n of ['october20','halloween','christmas','new-year'])document.body.classList.toggle('event-'+n,n===k);}}catch{}</script>
<header class="site-header"><div class="header-inner"><a class="brand" href="/" aria-label="Gold — Trang chủ"><span class="gold-logo"><img src="/portal/gold-logo.png" alt="Gold"></span><span class="brand-caption">Y TẾ TOÀN CẦU<span>Cổng truy cập hệ sinh thái</span></span></a><nav class="top-navigation" aria-label="Điều hướng chính"><a href="/"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-6v-7h-4v7H4a1 1 0 0 1-1-1z"/></svg><span>Trang chủ</span></a><a class="active" href="/music" aria-current="page"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18V5l12-2v13M9 18c0 1.7-1.6 3-3.5 3S2 20.7 2 19s1.6-3 3.5-3S9 16.3 9 18Zm12-2c0 1.7-1.6 3-3.5 3S14 17.7 14 16s1.6-3 3.5-3 3.5 1.3 3.5 3Z"/></svg><span>Âm nhạc</span></a><a href="/news"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16v16H4zM8 8h8M8 12h8m-8 4h5"/></svg><span>Tin tức</span></a></nav></div></header>
<main class="page music-room-page">
<section class="welcome music-room-welcome"><div><p class="eyebrow"><span></span> GOLD CENTRAL · GOLD MUSIC ROOM</p><h1>Âm nhạc Gold</h1><p>Chọn playlist của phòng ban hoặc cùng nghe danh sách của toàn hệ thống.</p></div><div class="music-room-select"><label for="music-department-trigger">Danh sách phát</label><div class="music-select" id="music-department-select"><button type="button" id="music-department-trigger" class="music-select-trigger" aria-haspopup="listbox" aria-controls="music-department-options" aria-expanded="false"><span id="music-department-label">Tất cả phòng ban</span><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 7.5 5 5 5-5"/></svg></button><div id="music-department-options" class="music-select-options" role="listbox" aria-label="Chọn danh sách phát" hidden><button type="button" role="option" data-value="all" aria-selected="true">Tất cả phòng ban</button><button type="button" role="option" data-value="vaccination" aria-selected="false">Tiêm chủng</button><button type="button" role="option" data-value="dermatology" aria-selected="false">Da liễu &amp; Thẩm mỹ</button><button type="button" role="option" data-value="rehabilitation" aria-selected="false">Phục hồi chức năng</button><button type="button" role="option" data-value="wellness" aria-selected="false">Dưỡng sinh</button><button type="button" role="option" data-value="office" aria-selected="false">Văn phòng &amp; Nội bộ</button></div></div><select id="music-department" class="music-native-select" tabindex="-1" aria-hidden="true"><option value="all">Tất cả phòng ban</option><option value="vaccination">Tiêm chủng</option><option value="dermatology">Da liễu &amp; Thẩm mỹ</option><option value="rehabilitation">Phục hồi chức năng</option><option value="wellness">Dưỡng sinh</option><option value="office">Văn phòng &amp; Nội bộ</option></select></div></section>
<section class="music-room" aria-label="Trình phát nhạc">
<div class="music-room-player"><div class="music-room-glow" aria-hidden="true"></div><span class="music-room-kicker">GOLD · MUSIC ROOM</span><div class="music-room-art" id="music-art" aria-hidden="true"><div class="music-vinyl-disc"><span>G</span></div></div><div class="music-room-now"><small id="music-status">SẴN SÀNG PHÁT</small><h2 id="music-title">Chọn một bài hát</h2><p id="music-artist">Playlist nội bộ Gold</p></div><input id="music-progress" class="music-progress" type="range" min="0" max="1000" value="0" aria-label="Tiến độ bài hát"><div class="music-time-row"><span id="music-current-time">00:00</span><b aria-hidden="true">/</b><span id="music-duration">00:00</span></div><div class="music-controls music-room-controls"><button type="button" id="music-previous" class="music-icon-button" aria-label="Bài trước"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 5v14M19 6 8 12l11 6V6Z"/></svg></button><button type="button" id="music-play" class="music-play-button" aria-label="Phát nhạc"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 11 7-11 7z"/></svg></button><button type="button" id="music-next" class="music-icon-button" aria-label="Bài tiếp theo"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 5v14M5 6l11 6-11 6V6Z"/></svg></button><button type="button" id="music-repeat" class="music-icon-button music-repeat-button active" aria-label="Đang lặp danh sách" aria-pressed="true" title="Lặp danh sách"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m17 2 4 4-4 4M3 11V9a3 3 0 0 1 3-3h15M7 22l-4-4 4-4m14-1v2a3 3 0 0 1-3 3H3"/></svg><span id="music-repeat-one" hidden>1</span></button></div><p class="music-room-mode" id="music-mode">Tự động chuyển bài · Lặp toàn bộ danh sách</p></div>
<aside class="music-room-queue"><div class="music-queue-heading"><div><span class="music-room-kicker">PLAYLIST CỦA BẠN</span><h2>Danh sách bài hát</h2></div><span id="music-queue-count">0 bài</span></div><div id="music-track-list" class="music-track-list" aria-live="polite"><p class="music-list-empty">Đang tải danh sách phát…</p></div></aside>
</section>
<aside id="music-dock" class="music-dock" aria-label="Trình phát nhạc Gold"><div class="music-mini-player"><button type="button" id="music-open" class="music-mini-open" aria-label="Mở phòng nhạc"><span class="music-mini-icon music-disc" aria-hidden="true"><i></i><b>G</b></span><span class="music-mini-copy"><strong id="music-mini-title">Gold Music</strong><small id="music-mini-subtitle">Mở phòng nhạc</small></span></button><a class="music-bar-link" href="/music">Mở phòng nhạc</a><span class="music-global-controls"><button type="button" id="music-mini-previous" class="music-mini-next" aria-label="Bài trước"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 5v14M19 6 8 12l11 6V6Z"/></svg></button><button type="button" id="music-mini-next" class="music-mini-next" aria-label="Bài tiếp theo"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 5v14M5 6l11 6-11 6V6Z"/></svg></button><button type="button" id="music-mini-play" class="music-mini-play" aria-label="Phát nhạc"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 11 7-11 7z"/></svg></button></span><span class="music-mini-timeline"><input id="music-mini-progress" class="music-mini-progress" type="range" min="0" max="1000" value="0" aria-label="Tiến độ phát nhạc"><small class="music-mini-clock"><span id="music-mini-elapsed">00:00</span><b aria-hidden="true">/</b><span id="music-mini-duration">00:00</span></small></span><button type="button" id="music-mini-close" class="music-mini-close" aria-label="Tắt nhạc và ẩn trình phát" title="Tắt nhạc và ẩn trình phát">×</button></div></aside>
<audio id="music-audio" preload="auto"></audio>
<footer><span>© @DateTime.Now.Year Gold Ninh Bình <span class="footer-separator">·</span> Công ty Cổ phần Y tế Toàn Cầu</span></footer>
</main>
<script src="/portal/event-theme.js?v=1" defer></script><script src="/portal/music.js?v=15" defer></script>
</body></html>
