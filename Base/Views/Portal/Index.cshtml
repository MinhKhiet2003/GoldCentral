<button id="department-rehabilitation" role="tab" data-department="rehabilitation" aria-selected="false" aria-controls="department-panel" tabindex="-1">Phục hồi chức năng <span></span></button>
<button id="department-wellness" role="tab" data-department="wellness" aria-selected="false" aria-controls="department-panel" tabindex="-1">Dưỡng sinh <span></span></button>
<button id="department-office" role="tab" data-department="office" aria-selected="false" aria-controls="department-panel" tabindex="-1">Văn phòng & Nội bộ <span></span></button>
