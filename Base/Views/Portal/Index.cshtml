@{ Layout = null; var isAdmin = Context.Request.Path.StartsWithSegments("/admin"); }
<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#087542">
<title>Gold · Cổng truy cập hệ sinh thái</title><link rel="stylesheet" href="/portal/portal.css?v=30">
</head>
<body class="@(isAdmin ? "login-only" : "")" data-admin="@(isAdmin ? "true" : "false")">
<header class="site-header"><div class="header-inner">
<a class="brand" href="/" aria-label="Gold — Trang chủ"><span class="gold-logo"><img src="/portal/gold-logo.png" alt="Gold"></span><span class="brand-caption">Y TẾ TOÀN CẦU<span>Cổng truy cập hệ sinh thái</span></span></a>
@if (isAdmin)
{
<div class="admin-header"><a href="/" class="back-home">← Trang chủ</a><button class="secondary" id="logout" hidden>Đăng xuất</button></div>
}
else
{
<nav class="top-navigation" aria-label="Điều hướng chính"><a class="active" href="/" aria-current="page">Trang chủ</a><a href="/news">Tin tức</a></nav>
}
</div></header>
<main class="page">
<section id="login-panel" class="login-panel" hidden>
<form id="login-form"><span class="eyebrow">GOLD CENTRAL · QUẢN TRỊ</span><h1>Đăng nhập quản trị</h1><p class="hint">Quản lý các kết nối trong hệ sinh thái Gold.</p><label>Tên đăng nhập<input name="username" required autocomplete="username" placeholder="Nhập tên đăng nhập"></label><label>Mật khẩu<input type="password" name="password" required autocomplete="current-password" placeholder="Nhập mật khẩu"></label><p id="login-error" class="error" role="alert" tabindex="-1"></p><button class="primary" type="submit">Đăng nhập <span>→</span></button></form>
</section>
<div id="portal-content" hidden>
<nav class="admin-nav" id="admin-nav" aria-label="Điều hướng quản trị" hidden><button class="active" data-view="manage">Quản lý ứng dụng</button><button data-view="stats">Thống kê truy cập</button><button data-view="news">Quản lý tin tức</button></nav>
<section id="news-admin-panel" hidden>
<div class="welcome"><div><p class="eyebrow">GOLD CENTRAL · TIN TỨC NỘI BỘ</p><h1>Quản lý tin tức</h1><p>Soạn bài, cập nhật thông tin và xuất bản đến nhân viên.</p></div><button class="primary" id="add-news">＋ Viết bài mới</button></div>
<div class="news-admin-tools"><label class="search"><input id="news-admin-search" aria-label="Tìm bài viết quản trị" placeholder="Tìm tiêu đề, nội dung tóm tắt..."></label><select id="news-admin-status" aria-label="Trạng thái bài viết"><option value="">Tất cả trạng thái</option><option value="true">Đã xuất bản</option><option value="false">Bản nháp / Đang ẩn</option></select></div>
<div id="news-admin-results" aria-live="polite"></div><div class="news-pagination" id="news-admin-pagination"></div>
</section>
<div class="portal-layout">
<aside class="department-sidebar"><p class="department-sidebar-title">ĐƠN VỊ & PHÒNG BAN</p><div class="department-tabs" id="department-tabs" role="tablist" aria-label="Đơn vị và phòng ban" aria-orientation="vertical">
<button id="department-all" role="tab" data-department="all" aria-selected="true" aria-controls="department-panel" tabindex="0">Tất cả <span></span></button>
<button id="department-vaccination" role="tab" data-department="vaccination" aria-selected="false" aria-controls="department-panel" tabindex="-1">Tiêm chủng <span></span></button>
<button id="department-dermatology" role="tab" data-department="dermatology" aria-selected="false" aria-controls="department-panel" tabindex="-1">Da liễu & Thẩm mỹ <span></span></button>
<button id="department-rehabilitation" role="tab" data-department="rehabilitation" aria-selected="false" aria-controls="department-panel" tabindex="-1">Phục hồi chức năng <span></span></button>
<button id="department-wellness" role="tab" data-department="wellness" aria-selected="false" aria-controls="department-panel" tabindex="-1">Dưỡng sinh <span></span></button>
<button id="department-office" role="tab" data-department="office" aria-selected="false" aria-controls="department-panel" tabindex="-1">Văn phòng & Nội bộ <span></span></button>
</div>
</aside>
<div class="portal-main"><section class="welcome"><div><p class="eyebrow"><span></span> KẾT NỐI HỆ SINH THÁI GOLD</p><h1 id="page-title">Bạn muốn truy cập hệ thống nào?</h1><p id="page-subtitle">Chọn ứng dụng để bắt đầu công việc của bạn.</p></div><button class="primary" id="add-app" hidden>＋ Thêm ứng dụng</button></section>
<div class="stats-period" id="stats-period" hidden><div class="stats-date-control"><span class="stats-date-title">Khoảng thời gian thống kê</span><div class="stats-date-inputs"><label class="date-field"><span>Từ ngày</span><button type="button" class="date-trigger" data-date-target="stats-date-from" aria-haspopup="dialog" aria-expanded="false"><span class="date-trigger-value">Chọn ngày</span><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="16" rx="2"/><path d="M8 3v4m8-4v4M4 10h16"/></svg></button><div class="date-calendar" role="dialog" aria-label="Chọn ngày bắt đầu"></div><input id="stats-date-from" type="date" min="2000-01-01" max="9998-12-31" tabindex="-1" aria-hidden="true"></label><span class="date-separator" aria-hidden="true">→</span><label class="date-field"><span>Đến ngày</span><button type="button" class="date-trigger" data-date-target="stats-date-to" aria-haspopup="dialog" aria-expanded="false"><span class="date-trigger-value">Chọn ngày</span><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="16" rx="2"/><path d="M8 3v4m8-4v4M4 10h16"/></svg></button><div class="date-calendar" role="dialog" aria-label="Chọn ngày kết thúc"></div><input id="stats-date-to" type="date" min="2000-01-01" max="9998-12-31" tabindex="-1" aria-hidden="true"></label></div><div class="stats-date-presets" role="group" aria-label="Chọn nhanh ngày"><button type="button" data-date-preset="yesterday" aria-pressed="false">Hôm qua</button><button type="button" data-date-preset="today" aria-pressed="false">Hôm nay</button></div></div><p id="stats-range"></p></div>
<section class="metrics" id="metrics" hidden aria-label="Thống kê tổng quan"></section><p id="stats-history-note" class="hint" hidden>Giờ Việt Nam (UTC+7). Tuần từ thứ Hai đến Chủ nhật; tháng theo lịch. Lượt nhấp trước lần nâng cấp chỉ có trong Tổng.</p>
<section class="report-section" id="report-section" hidden aria-label="Biểu đồ truy cập"><div class="report-heading"><div><p class="eyebrow">PHÂN TÍCH LƯỢT TRUY CẬP</p><h2>Báo cáo hệ sinh thái</h2></div><p id="report-range-label" class="report-range-label"></p></div><div class="report-charts" id="report-charts"></div></section>
<section class="directory" id="directory" aria-label="Danh sách ứng dụng">
<div class="tools"><label class="search"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4.5 4.5"/></svg><input id="search" aria-label="Tìm ứng dụng" placeholder="Tìm ứng dụng trong hệ sinh thái Gold..." autocomplete="off"><kbd>/</kbd></label><select id="category-filter" aria-label="Lọc hệ thống"><option value="all">Tất cả lĩnh vực</option><option value="vaccination">Tiêm chủng</option><option value="dermatology">Da liễu & Thẩm mỹ</option><option value="rehabilitation">Phục hồi chức năng</option><option value="wellness">Dưỡng sinh</option><option value="office">Văn phòng & Nội bộ</option></select><select id="sort" aria-label="Sắp xếp" hidden><option value="order">Thứ tự mặc định</option><option value="name">Tên A → Z</option><option value="clicks">Truy cập nhiều nhất</option></select></div>
<div class="filter-row"><label class="platform-select"><span>Nền tảng</span><select id="platform-filter" aria-label="Lọc nền tảng"><option value="all">Tất cả nền tảng</option><option value="system">Hệ thống Gold</option><option value="facebook">Facebook</option><option value="zalo">Zalo</option><option value="tiktok">TikTok</option><option value="youtube">YouTube</option><option value="website">Website</option></select></label><span class="result-label" id="result-count" aria-live="polite"></span></div>
<section id="favorites-section" class="application-section"><div class="section-heading"><div><h2>Yêu thích <span id="favorite-count">0</span></h2><p>Các ứng dụng bạn đã lưu để truy cập nhanh.</p></div><span class="section-symbol" aria-hidden="true">♡</span></div><div id="favorite-results" class="card-grid" aria-live="polite"></div></section>
<section class="application-section" id="app-management-section" hidden><div class="section-heading"><div><h2 id="directory-title">Danh sách ứng dụng <span id="app-count"></span></h2><p id="directory-subtitle">Khám phá các hệ thống và kênh kết nối của Gold.</p></div></div><div id="results" class="card-grid" aria-live="polite"></div></section>
<section id="catalog-section" class="application-section catalog-section" hidden>
<div class="section-heading"><div><h2>Tất cả ứng dụng <span id="catalog-count">0</span></h2><p>Chọn đơn vị để xem đầy đủ hệ thống và các kênh mạng xã hội.</p></div></div>
<div class="catalog-layout">
<div id="department-panel" role="tabpanel" aria-labelledby="department-all" tabindex="0">
<div class="catalog-filters"><div id="type-filters" class="type-filters" role="group" aria-label="Loại ứng dụng"><button data-type="all" aria-pressed="true">Tất cả loại</button><button data-type="system" aria-pressed="false">Hệ thống <span id="system-count"></span></button><button data-type="social" aria-pressed="false">Mạng xã hội & Website <span id="social-count"></span></button></div><select id="catalog-platform-filter" aria-label="Mạng xã hội và website" hidden><option value="all">Tất cả kênh kết nối</option><option value="facebook">Facebook</option><option value="zalo">Zalo</option><option value="tiktok">TikTok</option><option value="youtube">YouTube</option><option value="website">Website</option></select><select id="catalog-department-filter" aria-label="Lọc mạng xã hội theo phòng ban" hidden><option value="all">Tất cả phòng ban</option><option value="vaccination">Tiêm chủng</option><option value="dermatology">Da liễu & Thẩm mỹ</option><option value="rehabilitation">Phục hồi chức năng</option><option value="wellness">Dưỡng sinh</option><option value="office">Văn phòng & Nội bộ</option></select></div>
<div class="catalog-heading"><h3 id="department-title">Tất cả đơn vị</h3><span id="catalog-result-count" aria-live="polite"></span></div>
<div id="catalog-results" class="card-grid" aria-live="polite"></div>
</div></div></section>
<p class="directory-note">Một cổng kết nối. Toàn bộ hệ sinh thái Gold.</p>
</section>
</div>
</div></div>
<footer><span>© @DateTime.Now.Year Gold Ninh Bình <span class="footer-separator">·</span> Công ty Cổ phần Y tế Toàn Cầu</span><button id="about">Về Gold <span aria-hidden="true">↗</span></button></footer>
</main>
<dialog id="editor"><form id="app-form"><div class="dialog-heading"><div><span class="eyebrow">GOLD CENTRAL</span><h2 id="editor-title">Thêm ứng dụng</h2></div><button type="button" class="close" aria-label="Đóng">×</button></div><input type="hidden" name="id"><label>Tên ứng dụng<input name="name" required maxlength="100" placeholder="Ví dụ: Gold Tiêm chủng"></label><label>Mô tả<textarea name="description" maxlength="400" rows="2"></textarea></label><div class="form-row"><label>Hệ thống<select name="category"><option value="vaccination">Tiêm chủng</option><option value="dermatology">Da liễu & Thẩm mỹ</option><option value="rehabilitation">Phục hồi chức năng</option><option value="wellness">Dưỡng sinh</option><option value="office">Văn phòng & Nội bộ</option></select></label><label>Nền tảng<select name="platform"><option value="system">Ứng dụng nội bộ</option><option value="facebook">Facebook</option><option value="zalo">Zalo</option><option value="tiktok">TikTok</option><option value="youtube">YouTube</option><option value="website">Website</option></select></label></div><label>Đường dẫn truy cập<input name="url" type="url" maxlength="2000" placeholder="https://..."></label><label>Ảnh bìa ứng dụng<input name="imageUrl" maxlength="2000" placeholder="URL ảnh hoặc tải lên bên dưới"></label><input id="image-file" type="file" accept="image/png,image/jpeg"><small class="hint">Ưu tiên ảnh ngang 16:9, PNG/JPG tối đa 10 MB. Không có ảnh sẽ hiển thị logo Gold.</small><div class="form-row"><label>Thứ tự hiển thị<input name="order" type="number" min="1" max="10000" value="1" required></label><label class="checkbox"><input name="isVisible" type="checkbox" checked> Hiển thị ứng dụng</label></div><p id="editor-error" class="error" role="alert"></p><div class="dialog-actions"><button type="button" class="secondary close">Hủy</button><button class="primary" type="submit">Lưu ứng dụng</button></div></form></dialog>
<dialog id="news-editor" aria-labelledby="news-editor-title"><form id="news-form"><div class="dialog-heading"><div><span class="eyebrow">GOLD CENTRAL · NỘI BỘ</span><h2 id="news-editor-title">Viết bài mới</h2></div><button class="close" type="button" aria-label="Đóng form bài viết">×</button></div><input name="id" type="hidden"><label>Tiêu đề<input name="title" required maxlength="160" placeholder="Nhập tiêu đề bài viết"></label><label>Tóm tắt<textarea name="summary" maxlength="400" rows="2" placeholder="Nội dung tóm tắt hiển thị trên thẻ tin"></textarea></label><label>Nội dung<textarea name="content" required maxlength="30000" rows="10" placeholder="Viết nội dung bài thông báo..."></textarea></label><label>Phòng ban<select name="department"><option value="all">Toàn công ty</option><option value="vaccination">Tiêm chủng</option><option value="dermatology">Da liễu & Thẩm mỹ</option><option value="rehabilitation">Phục hồi chức năng</option><option value="wellness">Dưỡng sinh</option><option value="office">Văn phòng & Nội bộ</option></select></label><label>Ảnh bìa<input name="imageUrl" maxlength="2000" placeholder="URL HTTPS hoặc ảnh tải lên"></label><input id="news-image-file" type="file" accept="image/png,image/jpeg"><p class="hint">Ảnh PNG/JPG tối đa 10 MB. Nội dung bài viết dùng văn bản thuần.</p><label class="news-publish"><input name="isPublished" type="checkbox"> Xuất bản để nhân viên đọc</label><p id="news-editor-error" class="error" role="alert"></p><div class="dialog-actions"><button class="secondary close" type="button">Hủy</button><button class="primary" type="submit">Lưu bài viết</button></div></form></dialog>
<dialog id="news-delete-dialog"><h2>Xóa bài viết?</h2><p id="news-delete-title"></p><p class="hint">Bài viết sẽ bị xóa khỏi hệ thống.</p><p id="news-delete-error" class="error" role="alert"></p><div class="dialog-actions"><button class="secondary close">Hủy</button><button class="danger" id="confirm-delete-news">Xóa bài viết</button></div></dialog>
<dialog id="about-dialog" class="about-dialog" aria-labelledby="about-title" aria-describedby="about-subtitle">
<div class="about-header"><div class="about-brand"><span class="gold-logo"><img src="/portal/gold-logo.png" alt="Gold"></span><span class="about-tag">Y TẾ TOÀN CẦU</span></div><button class="close about-close" type="button" aria-label="Đóng giới thiệu"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button><h2 id="about-title">Gold Ninh Bình</h2><p id="about-subtitle">Công ty Cổ phần Y tế Toàn Cầu</p></div>
<div class="about-body">
<div class="about-item"><span class="about-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 4.8a5.2 5.2 0 0 0-7.4 0L12 5.9l-1.1-1.1a5.2 5.2 0 0 0-7.4 7.4L12 21l8.5-8.8a5.2 5.2 0 0 0 0-7.4Z"/><path d="M5 12h4l2-4 2 8 2-4h4"/></svg></span><div><h3>Tận tâm vì sức khỏe cộng đồng</h3><p>Tiên phong trong lĩnh vực tiêm chủng dịch vụ, không ngừng mở rộng các lĩnh vực chăm sóc sức khỏe toàn diện.</p></div></div>
<div class="about-item"><span class="about-icon about-icon-gold"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="3"/><path d="M7 3v4m10-4v4M3 10h18m-13 5h2m4 0h2m-8 3h2"/></svg></span><div><h3>Ngày thành lập</h3><p><time datetime="2017-03-03">03 tháng 03 năm 2017</time></p></div></div>
<div class="about-item"><span class="about-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.7"/></svg></span><div><h3>Địa chỉ</h3><p>389 Lê Thái Tổ, Phường Phúc Thành,<br>TP Ninh Bình, tỉnh Ninh Bình.</p></div></div>
<div class="about-note"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><path d="M14 17h7m-3.5-3.5v7"/></svg><p>Cổng kết nối ứng dụng và các kênh truyền thông của từng đơn vị. Quyền sử dụng tại mỗi ứng dụng do hệ thống đích quản lý.</p></div>
</div>
</dialog>
<dialog id="delete-dialog"><h2>Xóa ứng dụng?</h2><p id="delete-name"></p><p class="hint">Thẻ ứng dụng và số lượt nhấp của thẻ sẽ bị xóa.</p><div class="dialog-actions"><button class="secondary close">Hủy</button><button class="danger" id="confirm-delete">Xóa ứng dụng</button></div></dialog><div id="toast" role="status"></div><script src="/portal/portal.js?v=24" defer></script><script src="/portal/news-admin.js?v=4" defer></script><script src="/portal/controls.js?v=2" defer></script><script src="/portal/news-preview.js?v=5" defer></script></body></html>
















